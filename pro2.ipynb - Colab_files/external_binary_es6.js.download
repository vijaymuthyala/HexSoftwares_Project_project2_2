import pandas as pd

def run_common_dataframe_funcs(dfn: str, df: pd.DataFrame | pd.Series) -> None:
  """Runs common dataframe functions in IPython style."""
  print(f'>>> {dfn}.head(2)')
  print(df.head(2))
  if isinstance(df, pd.DataFrame):
    print(f'>>> {dfn}.columns.values')
    print(df.columns.values)

try:
  ${a}
  run_common_dataframe_funcs("${a}", ${a})
except NameError:
  print(">>> ${a}")
  print("NameError: name ${a} is not defined")
except Exception as e:
